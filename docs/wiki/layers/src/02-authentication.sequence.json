  "cards": [
    {
      "dot": "violet",
      "title": "Other ways in",
      "items": [
        "OIDC: /auth/login → IdP → /auth/callback, claims mapped to groups",
        "Kerberos: GET /auth/kibana answers SPNEGO Negotiate, groups looked up in LDAP",
        "Machines: Bearer JWT issued by an external IdP, verified with its JWKS"
      ]
    },
    {
      "dot": "rose",
      "title": "One identity",
      "items": [
        "Every method yields the same identity: subject + groups",
        "The ACL never knows which method was used",
        "Plain LDAP is refused unless an explicit dev option is set"
      ]
    },
    {
      "dot": "amber",
      "title": "Secrets",
      "items": [
        "YAML holds references only: ${env:NAME} or ${file:/path}",
        "Missing secret: the proxy refuses to start",
        "Secrets never reach logs or audit"
      ]
    }
  ]
