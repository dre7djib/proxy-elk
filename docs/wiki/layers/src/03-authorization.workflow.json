  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Deny by default",
      "items": [
        "Only allow rules exist; anything not covered is refused",
        "Invalid or ambiguous YAML: the proxy refuses to start",
        "SIGHUP reloads the ACL; an invalid reload keeps the old one"
      ]
    },
    {
      "dot": "amber",
      "title": "Exceptions on purpose",
      "items": [
        "kibana_system (passthrough) is relayed unchanged, outside the ACL",
        "GET _security/_authenticate and _has_privileges answer for the caller only",
        "Every decision is written to the audit log"
      ]
    },
    {
      "dot": "cyan",
      "title": "Admin tools",
      "items": [
        "proxy -simulate: which rule lets user X read index Y",
        "configs/acl_cases.yaml: policy tests run by go test",
        "proxy -sync / -dry-run: Kibana spaces and roles per team"
      ]
    }
  ]
