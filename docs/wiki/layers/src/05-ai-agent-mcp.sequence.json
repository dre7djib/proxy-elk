  "cards": [
    {
      "dot": "emerald",
      "title": "What runs today",
      "items": [
        "One question → one read-only ES|QL query → one table",
        "The model only sees fields of indices the caller may read",
        "Sending {esql} instead replays an edited query without the model"
      ]
    },
    {
      "dot": "slate",
      "title": "Planned agent (J2)",
      "items": [
        "Multi-turn chat with a bounded loop of tool calls",
        "Deterministic hooks before and after each call: ACL, read-only, limits, audit",
        "A hook can restrict or deny, never widen the user's rights"
      ]
    },
    {
      "dot": "violet",
      "title": "Planned MCP and log analysis (J3)",
      "items": [
        "MCP server over HTTP, personal tokens, same tools and hooks, audit source \"mcp\"",
        "Analyse one log with its context (trace.id, host, service)",
        "Field masking and a local model for sensitive indices"
      ]
    }
  ]
